{
  "info": {
    "_postman_id": "a9db5867-b8db-4e12-8700-1c39abfd3f2c",
    "name": "Inventory & Order Management - Core API",
    "description": "Postman Collection for managing products, customers, and orders in the Inventory & Order Management System. Includes validation payloads, inventory checking, and transactional rollbacks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"PROD-WIDGET-001\",\n  \"name\": \"Super Widget Extreme\",\n  \"description\": \"A super widget designed for ultimate performance and sleek aesthetics.\",\n  \"price\": 49.99\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/products/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                ""
              ]
            },
            "description": "Registers a new catalog item. Returns the generated Product with UUID, created_at, and updated_at timestamps.\n\nChecks SKU uniqueness; raises 400 Bad Request if SKU is already in use."
          },
          "response": []
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/products/?skip=0&limit=100",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                ""
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "0",
                  "description": "Offset index for pagination"
                },
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum records to return"
                }
              ]
            },
            "description": "Retrieves a paginated list of all products in the database catalog, sorted by SKU."
          },
          "response": []
        },
        {
          "name": "Get Product Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{product_id}}"
              ]
            },
            "description": "Retrieves product detailed parameters based on the unique Product UUID.\n\nRaises 404 Not Found if the ID is incorrect."
          },
          "response": []
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Super Widget Extreme II\",\n  \"price\": 59.99,\n  \"description\": \"Upgraded version of the original widget with enhanced features.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{product_id}}"
              ]
            },
            "description": "Modifies specified parameters on a product. Only fields passed in the request body are modified.\n\nAsserts SKU uniqueness if updating the SKU parameter."
          },
          "response": []
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{product_id}}"
              ]
            },
            "description": "Deletes the product from the catalog.\n\nRaises 404 Not Found if the product is not present."
          },
          "response": []
        }
      ]
    },
