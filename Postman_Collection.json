    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customer_id}}\",\n  \"items\": [\n    {\n      \"product_id\": \"{{product_id}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                ""
              ]
            },
            "description": "Places a new customer checkout order.\n* Validates customer presence.\n* Row-locks catalog products to check inventory levels.\n* Returns 400 Bad Request if stock level is insufficient.\n* Automatically decrements stock quantities, accumulates product prices, and logs line items.\n* Automatically rolls back all operations if any intermediate item check fails."
          },
          "response": []
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/?skip=0&limit=100",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                ""
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "0",
                  "description": "Offset index for pagination"
                },
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum records to return"
                }
              ]
            },
            "description": "Retrieves a paginated list of all orders in the database system."
          },
          "response": []
        },
        {
          "name": "Get Order Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{order_id}}"
              ]
            },
            "description": "Retrieves order parameters and sub-items based on the unique Order UUID.\n\nRaises 404 Not Found if missing."
          },
          "response": []
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{order_id}}/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{order_id}}",
                "cancel"
              ]
            },
            "description": "Cancels an active pending order and restores all purchased quantities back to the product's catalog stock level.\n\nRaises 400 Bad Request if the order has already been shipped."
          },
          "response": []
        }
      ]
    }
